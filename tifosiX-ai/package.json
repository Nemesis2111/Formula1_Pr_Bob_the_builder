{
  "name": "tifosix-ai",
  "version": "1.0.0",
  "description": "AI-Native Formula 1 Decision Operating System",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start"
  },
  "keywords": [
    "formula1",
    "ai",
    "telemetry",
    "governance",
    "multi-agent"
  ],
  "author": "TifosiX Team",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0"
  }
}
